[
  {
    "apiVersion": "v1",
    "data": {
      "haproxy.cfg": "global\n    maxconn 2048\ndefaults\n    mode tcp\n    timeout connect 5s\n    timeout client 1h\n    timeout server 1h\nfrontend db\n    bind :5432\n    default_backend gate\nbackend gate\n    server gate 100.66.16.2:5432 ssl crt /certs/tenant.pem ssl-min-ver TLSv1.2 ca-file /certs/ca.crt verify required sni str(0b0c0d0e-1111-4222-8333-444455556666.dbaas.internal) verifyhost 0b0c0d0e-1111-4222-8333-444455556666.dbaas.internal check check-ssl\nfrontend health\n    mode http\n    bind :8404\n    monitor-uri /healthz\n    monitor fail if { nbsrv(gate) lt 1 }\n"
    },
    "kind": "ConfigMap",
    "metadata": {
      "labels": {
        "app.kubernetes.io/instance": "0b0c0d0e-1111-4222-8333-444455556666",
        "app.kubernetes.io/managed-by": "bedrock",
        "bedrock.cloudyfolks.io/kind": "Database",
        "bedrock.cloudyfolks.io/name": "orders",
        "bedrock.cloudyfolks.io/project": "web",
        "bedrock.cloudyfolks.io/tenant": "acme"
      },
      "name": "orders-endpoint",
      "namespace": "acme-web",
      "ownerReferences": [
        {
          "apiVersion": "bedrock.cloudyfolks.io/v1alpha1",
          "blockOwnerDeletion": true,
          "controller": true,
          "kind": "Database",
          "name": "orders",
          "uid": "0b0c0d0e-1111-4222-8333-444455556666"
        }
      ]
    }
  },

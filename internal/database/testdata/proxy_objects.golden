      },
      "name": "orders-endpoint",
      "namespace": "acme-web",
      "ownerReferences": [
        {
          "apiVersion": "bedrock.cloudyfolks.io/v1alpha1",
          "blockOwnerDeletion": true,
          "controller": true,
          "kind": "Database",
          "name": "orders",
          "uid": "0b0c0d0e-1111-4222-8333-444455556666"
        }
      ]
    },
    "spec": {
      "additionalOutputFormats": [
        {
          "type": "CombinedPEM"
        }
      ],
      "commonName": "0b0c0d0e-1111-4222-8333-444455556666",
      "duration": "43800h0m0s",
      "issuerRef": {
        "group": "cert-manager.io",
        "kind": "ClusterIssuer",
        "name": "bedrock-database-ca"
      },
      "privateKey": {
        "algorithm": "ECDSA",
        "rotationPolicy": "Always",
        "size": 256
      },
      "renewBefore": "8760h0m0s",
      "secretName": "orders-endpoint",
      "secretTemplate": {
        "annotations": {},
        "labels": {
          "app.kubernetes.io/instance": "0b0c0d0e-1111-4222-8333-444455556666",
          "app.kubernetes.io/managed-by": "bedrock",
          "bedrock.cloudyfolks.io/kind": "Database",
          "bedrock.cloudyfolks.io/name": "orders",

apiVersion: bedrock.cloudyfolks.io/v1alpha1
kind: ClusterConfig
metadata:
  name: e2e
spec:
  version: ${VERSION}
  api:
    vip: ${VIP}
  platform:
    host: ${PLATFORM_HOST}
  network:
    managementInterface: ${IFACE}
    fabric:
      providerNetworks: ${PROVIDER_NETWORKS}
  storage:
    devices: ${OSD_DEVICES}
  virtualization:
    emulation: ${EMULATION}
  roles: [control-plane, ceph-osd, fabric-gateway, workload]

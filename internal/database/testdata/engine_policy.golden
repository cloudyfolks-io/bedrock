[
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "NetworkPolicy",
    "metadata": {
      "name": "0b0c0d0e-1111-4222-8333-444455556666",
      "namespace": "bedrock-dbaas"
    },
    "spec": {
      "ingress": [
        {
          "from": [
            {
              "podSelector": {
                "matchExpressions": [
                  {
                    "key": "app.kubernetes.io/component",
                    "operator": "In",
                    "values": [
                      "gate",
                      "engine"
                    ]
                  }
                ],
                "matchLabels": {
                  "app.kubernetes.io/instance": "0b0c0d0e-1111-4222-8333-444455556666"
                }
              }
            }
          ]
        }
      ],
      "podSelector": {
        "matchLabels": {
          "app.kubernetes.io/component": "engine",
          "app.kubernetes.io/instance": "0b0c0d0e-1111-4222-8333-444455556666"
        }
      },
      "policyTypes": [
        "Ingress"
      ]
    }
  }
]

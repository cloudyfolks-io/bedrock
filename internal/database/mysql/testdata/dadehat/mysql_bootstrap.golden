DROP USER IF EXISTS 'root'@'%';
GRANT SYSTEM_USER ON *.* TO 'root'@'localhost';
CREATE USER IF NOT EXISTS 'dbadmin'@'%' IDENTIFIED WITH caching_sha2_password AS 0x244124303035616161616161616161616161616161616161;
ALTER USER 'dbadmin'@'%' IDENTIFIED WITH caching_sha2_password AS 0x244124303035616161616161616161616161616161616161;
GRANT CREATE USER, RELOAD, SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, ALTER, INDEX, REFERENCES, TRIGGER, EVENT, CREATE VIEW, SHOW VIEW, CREATE ROUTINE, ALTER ROUTINE, EXECUTE, LOCK TABLES, CREATE TEMPORARY TABLES ON *.* TO 'dbadmin'@'%' WITH GRANT OPTION;
REVOKE SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, ALTER, INDEX, REFERENCES, TRIGGER, EVENT, CREATE VIEW, SHOW VIEW, CREATE ROUTINE, ALTER ROUTINE, EXECUTE, LOCK TABLES, CREATE TEMPORARY TABLES ON mysql.* FROM 'dbadmin'@'%';
CREATE DATABASE IF NOT EXISTS `app` CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;

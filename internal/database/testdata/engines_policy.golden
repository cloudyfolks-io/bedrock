{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "labels": {
      "bedrock.cloudyfolks.io/kind": "NetworkPolicy",
      "bedrock.cloudyfolks.io/name": "engines"
    },
    "name": "engines",
    "namespace": "bedrock-dbaas"
  },
  "spec": {
    "ingress": [
      {
        "from": [
          {
            "namespaceSelector": {
              "matchExpressions": [
                {
                  "key": "kubernetes.io/metadata.name",
                  "operator": "In",
                  "values": [
                    "bedrock-system",
                    "cnpg",
                    "ps-operator",
                    "monitoring"
                  ]
                }
              ]
            }
          }
        ]
      }
    ],
    "podSelector": {
      "matchLabels": {
        "bedrock.cloudyfolks.io/database-role": "engine"
      }
    },
    "policyTypes": [
      "Ingress"
    ]
  }
}
